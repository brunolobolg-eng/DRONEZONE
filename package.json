{
  "name": "kyiv-fpv",
  "version": "0.1.0",
  "description": "Kyiv FPV: simulador de voo FPV com física própria, para navegador e Electron (protótipo)",
  "main": "dist-electron/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "npm run build:web && npm run build:electron && electron .",
    "dev:electron": "KYIV_FPV_DEV_URL=http://localhost:5173 electron .",
    "dist:win": "npm run build:web && npm run build:electron && electron-builder --win --x64",
    "dist:dir": "npm run build:web && npm run build:electron && electron-builder --dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "check": "npm run typecheck && npm test"
  },
  "build": {
    "appId": "com.example.kyivfpv",
    "productName": "Kyiv FPV",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
